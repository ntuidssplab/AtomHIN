## TrainerConfig
dataset_config__name                                  = atomic-dblp
dataset_config__feat_types                            = {"authorfeat": "none", "conference": "nid", "numerical": "none", "paper": "none", "paperfeat": "nid", "term": "none", "author": "none"}
dataset_config__verbose                               = False
dataset_config__raw_path                              = HGB
dataset_config__prepropagation_config__reduce_fn      = absmax
dataset_config__prepropagation_config__cache_dir      = ${WORK}/preprop-ndblp
dataset_config__exclude_edge_types                    = ["has-authorfeat", "is-authorfeat-of", "has-numerical", "is-numerical-of"]
hgnn_config__name                                     = RGCN
hgnn_config__hidden_dim                               = 64
hgnn_config__num_layers                               = 11
hgnn_config__num_out_layers                           = 5
hgnn_config__num_heads                                = 6
hgnn_config__activation                               = elu
hgnn_config__lr                                       = 0.001
hgnn_config__weight_decay                             = 0.01
hgnn_config__max_lr_scale                             = 1.5
hgnn_config__pct_start_epoch                          = 50
hgnn_config__dropout                                  = {"feat": 0.55, "edge": 0.55}
hgnn_config__use_norm                                 = False
hgnn_config__use_residual                             = True
hgnn_config__add_self_loop                            = True
hgnn_config__proj_by                                  = shared
hgnn_config__linear_by                                = identity
hgnn_config__softmax_tau                              = 1.0
hgnn_config__aggregation                              = macro

device                                                = cuda:0
epochs                                                = 300
loss_fn__name                                         = ce
loss_fn__l2_norm                                      = True
tracker_config__log_root_dir                          = runs
tracker_config__early_stopping_rounds                 = 30
tracker_config__epochs_per_checkpoint                 = 0
tracker_config__save_n_best                           = 0
tracker_config__save_end                              = False
tracker_config__comment                               = .ndblp.sRGCN
tracker_config__verbose                               = True
tracker_config__progress                              = tqdm
batch_config__train__name                             = whole_graph
batch_config__eval__name                              = whole_graph
batch_config__device_mode                             = gpu
evaluator_config__name                                = hgb-nc
evaluator_config__early_stopping_objective            = loss
evaluator_config__epochs_per_eval                     = 1