_verbose=True
_progress=tqdm
## TrainerConfig
dataset_config__name                                      = atomic-mag
dataset_config__save_dir                                  = ${WORK}/datasets
dataset_config__feat_types                                = {"paper": "none", "institution": "none", "field_of_study": "u(256, -0.5, 0.5, 2731)", "author": "none", "numerical": "nid", "year": "nid"}
dataset_config__verbose                                   = False
dataset_config__symmetric_citing                          = True
dataset_config__prepropagation_config__reduce_fn          = absmax
dataset_config__prepropagation_config__cache_dir          = ${WORK}/prepropagation-nmag-slot-coo
dataset_config__prepropagation_config__verbose            = ${_verbose}
dataset_config__exclude_edge_types                        = ["year-of-publication", "published-in-year"]
data_loading_config__train__name                          = memory
data_loading_config__train__device                        = cpu
data_loading_config__train__verbose                       = ${_verbose}
data_loading_config__eval__name                           = memory
data_loading_config__eval__device                         = cpu
data_loading_config__eval__verbose                        = ${_verbose}
hgnn_config__name                                         = SRGCN
hgnn_config__hidden_dim                                   = 512
hgnn_config__mp_config__num_hops                          = 3
hgnn_config__num_pseudo_layers                            = 8
hgnn_config__num_in_layers                                = 1
hgnn_config__num_out_layers                               = 3
hgnn_config__out_norm_type                                = batch
hgnn_config__num_heads                                    = 2
hgnn_config__lr                                           = 0.01
hgnn_config__weight_decay                                 = 1e-06
hgnn_config__input_drop                                   = 0.05
hgnn_config__channel_drop                                 = 0.0
hgnn_config__dropout                                      = 0.55
hgnn_config__use_residual                                 = True
hgnn_config__weight_scalar                                = 0.1
hgnn_config__tgt_feat_residual                            = True
hgnn_config__proj_by                                      = ntype
hgnn_config__softmax_tau                                  = 1.0
hgnn_config__precomputation_config__drop_unlabeled        = False
hgnn_config__precomputation_config__verbose               = ${_verbose}
hgnn_config__precomputation_config__store_dir             = ${WORK}/precomputation-nmag-slot-float16
hgnn_config__precomputation_config__cache_idx_dtype       = int32
hgnn_config__precomputation_config__cache_val_dtype       = float16
hgnn_config__feat_fmt                                     = strided
hgnn_config__lpa_config__name                             = label_feats
hgnn_config__lpa_config__num_in_layers                    = 1
hgnn_config__lpa_config__input_drop                       = 0.05
hgnn_config__lpa_config__dropout                          = 0.5
hgnn_config__lpa_config__mp_config__num_hops              = 4
hgnn_config__lpa_config__mp_config__exclude_edge_types    = ["has-numerical", "is-numerical-of"]
hgnn_config__lpa_config__num_out_layers                   = 3
hgnn_config__lpa_config__num_pseudo_layers                = 5
hgnn_config__lpa_config__num_heads                        = 16
amp                                                       = float16
device                                                    = cuda
epochs                                                    = 800
loss_fn__name                                             = ce
loss_fn__l2_norm                                          = False
tracker_config__log_root_dir                              = runs
tracker_config__early_stopping_rounds                     = 300
tracker_config__epochs_per_checkpoint                     = 0
tracker_config__save_n_best                               = 0
tracker_config__save_end                                  = False
tracker_config__comment                                   = .nmag.SRGCN
tracker_config__verbose                                   = ${_verbose}
tracker_config__progress                                  = ${_progress}
batch_config__train__batch_size                           = 10000
batch_config__train__num_workers                          = 0
batch_config__train__pin_memory                           = False
batch_config__train__persistent_workers                   = False
batch_config__train__chunk_size                           = 1000
batch_config__eval__batch_size                            = 10000
batch_config__eval__num_workers                           = 0
batch_config__eval__pin_memory                            = False
batch_config__eval__persistent_workers                    = False
evaluator_config__name                                    = acc
evaluator_config__early_stopping_objective                = acc
evaluator_config__epochs_per_eval                         = 0.3
