## TrainerConfig
dataset_config__name                                = lastfm
dataset_config__feat_types                          = {"user": "none", "artist": "none", "tag": "nid_coo"}
dataset_config__verbose                             = False
dataset_config__raw_path                            = HGB
dataset_config__use_symmetric_user_user             = True
dataset_config__fix_valid                           = True
dataset_config__prepropagation_config__reduce_fn    = absmax
dataset_config__prepropagation_config__cache_dir    = ${WORK}/prepropagation-lastfm
dataset_config__prepropagation_config__verbose      = False
dataset_config__exclude_edge_types                  = ["user-artist", "artist-user", "user-user"]
hgnn_config__name                                   = RGCN
hgnn_config__hidden_dim                             = 128
hgnn_config__num_layers                             = 0
hgnn_config__num_out_layers                         = 3
hgnn_config__num_heads                              = 8
hgnn_config__activation                             = elu
hgnn_config__lr                                     = 1e-05
hgnn_config__weight_decay                           = 0.1
hgnn_config__max_lr_scale                           = 1.5
hgnn_config__pct_start_epoch                        = 50
hgnn_config__dropout__feat                          = 0.2
hgnn_config__dropout__edge                          = 0.35000000000000003
hgnn_config__use_norm                               = False
hgnn_config__use_residual                           = True
hgnn_config__add_self_loop                          = True
hgnn_config__proj_by                                = ntype
hgnn_config__linear_by                              = identity
hgnn_config__softmax_tau                            = 1.0
hgnn_config__aggregation                            = macro

decoder_config__name                                = dot
decoder_config__dim                                 = 1024
decoder_config__l2_norm                             = False
negative_sampler_config__train                      = uniform
negative_sampler_config__val__name                  = 2hop
negative_sampler_config__val__cache_dir             = ${WORK}/nhop-negative-sampling
device                                              = cuda:0
epochs                                              = 10000
loss_fn__name                                       = bce
loss_fn__l2_norm                                    = False
tracker_config__log_root_dir                        = runs
tracker_config__early_stopping_rounds               = 100
tracker_config__epochs_per_checkpoint               = 0
tracker_config__save_n_best                         = 0
tracker_config__save_end                            = False
tracker_config__comment                             = .lastfm.RGCN
tracker_config__verbose                             = True
tracker_config__progress                            = tqdm
batch_config__train__name                           = whole_graph
batch_config__eval__name                            = whole_graph
evaluator_config__name                              = hgb-lp
evaluator_config__early_stopping_objective          = roc_auc
evaluator_config__epochs_per_eval                   = 10

