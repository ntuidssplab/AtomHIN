## TrainerConfig
dataset_config__name                                  = freebase
dataset_config__feat_types                            = {"book": "nid_coo", "business": "nid_coo", "film": "none", "location": "none", "music": "nid_coo", "organization": "nid_coo", "people": "none", "sports": "nid_coo"}
dataset_config__verbose                               = False
dataset_config__raw_path                              = HGB
dataset_config__prepropagation_config__reduce_fn      = absmax
dataset_config__prepropagation_config__cache_dir      = ${WORK}/prepropagation-freebase-coo_
dataset_config__prepropagation_config__verbose        = False
dataset_config__exclude_edge_types                    = ["book-to-film", "book-to-film-inv", "business-on-location", "business-on-location-inv", "music-in-book", "music-in-book-inv", "music-in-film", "music-in-film-inv", "organization-and-organization", "organization-and-organization-inv", "organization-for-business", "organization-for-business-inv", "organization-in-film", "organization-in-film-inv", "organization-to-sports", "organization-to-sports-inv", "people-in-business", "people-in-business-inv", "people-in-organization", "people-in-organization-inv", "people-to-music", "people-to-music-inv", "people-to-sports", "people-to-sports-inv"]
