_verbose = False
## TrainerConfig
dataset_config__name                               = atomic-pubmed
dataset_config__raw_path                           = HGB
dataset_config__feat_types__chemical         = none
dataset_config__feat_types__disease          = none
dataset_config__feat_types__gene             = none
dataset_config__feat_types__species          = none
dataset_config__feat_types__chemical_feat         = nid
dataset_config__feat_types__disease_feat          = nid
dataset_config__feat_types__gene_feat             = nid
dataset_config__feat_types__species_feat          = nid
dataset_config__exclude_edge_types          = ["species-has-feat", "feat-of-species", "disease-has-feat", "feat-of-disease", "chemical-has-feat", "feat-of-chemical", "gene-has-feat", "feat-of-gene"]
dataset_config__prepropagation_config__reduce_fn = absmax
dataset_config__prepropagation_config__cache_dir              = ${WORK}/prepropagation-npubmed-Re
dataset_config__prepropagation_config__verbose = ${_verbose}
dataset_config__prepropagation_config__to_sparse_threshold = 0.001
dataset_config__verbose                           = ${_verbose}



hgnn_config__name                             = RGCN
hgnn_config__hidden_dim                       = 48
hgnn_config__num_layers                       = 1
hgnn_config__num_out_layers                   = 0
hgnn_config__num_heads                        = 8
hgnn_config__activation                       = identity
hgnn_config__lr                               = 0.03162277660168379
hgnn_config__weight_decay                     = 0.00031622776601683794
hgnn_config__dropout__feat                    = 0.0
hgnn_config__dropout__edge                    = 0.0
hgnn_config__use_norm                         = False
hgnn_config__use_residual                     = True
hgnn_config__add_self_loop                    = True
hgnn_config__proj_by                          = ntype
hgnn_config__linear_by                        = identity
hgnn_config__softmax_tau                      = 1.0
hgnn_config__aggregation                      = micro

decoder_config__name                          = dist_mul
decoder_config__dim                           = 384
decoder_config__l2_norm                       = True
negative_sampler_config__train                = uniform
negative_sampler_config__val__name            = 2hop
negative_sampler_config__val__cache_dir       = ${WORK}/nhop-negative-sampling
negative_sampler_config__val__verbose         = False
device                                        = cuda:0
epochs                                        = 3000
loss_fn__name                                 = bce
loss_fn__l2_norm                              = False
tracker_config__log_root_dir                  = runs
tracker_config__early_stopping_rounds         = 10
tracker_config__epochs_per_checkpoint         = 0
tracker_config__save_n_best                   = 0
tracker_config__save_end                      = False
tracker_config__comment                       = .npubmed.RGCN
tracker_config__verbose                       = False
tracker_config__progress                      = none
batch_config__train__name                     = whole_graph
batch_config__eval__name                      = whole_graph
evaluator_config__name                        = hgb-lp
evaluator_config__early_stopping_objective    = roc_auc
evaluator_config__epochs_per_eval             = 50