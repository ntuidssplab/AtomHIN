## TrainerConfig
dataset_config__name                                = atomic-amazon
dataset_config__feat_types                          = {"product": "nid_coo", "price": "none", "sales_rank": "none", "brand": "none", "category": "none"}
dataset_config__verbose                             = False
dataset_config__raw_path                            = HGB
dataset_config__use_symmetric_etypes                = False
dataset_config__prepropagation_config__reduce_fn    = absmax
dataset_config__prepropagation_config__cache_dir    = ${WORK}/prepropagation-namazon
dataset_config__prepropagation_config__verbose      = False
dataset_config__exclude_edge_types                  = ["product-brand", "brand-product", "product-category", "category-product"]
hgnn_config__name                                   = RGCN
hgnn_config__hidden_dim                             = 32
hgnn_config__num_layers                             = 2
hgnn_config__num_out_layers                         = 0
hgnn_config__num_heads                              = 16
hgnn_config__activation                             = identity
hgnn_config__lr                                     = 0.01
hgnn_config__weight_decay                           = 3.1622776601683795e-05
hgnn_config__dropout__feat                          = 0.5
hgnn_config__dropout__edge                          = 0.5
hgnn_config__use_norm                               = False
hgnn_config__use_residual                           = True
hgnn_config__add_self_loop                          = True
hgnn_config__proj_by                                = ntype
hgnn_config__linear_by                              = identity
hgnn_config__softmax_tau                            = 1.0
hgnn_config__aggregation                            = macro

decoder_config__name                                = dist_mul
decoder_config__dim                                 = 512
decoder_config__l2_norm                             = True
negative_sampler_config__train                      = uniform
negative_sampler_config__val__name                  = 2hop
negative_sampler_config__val__cache_dir             = ${WORK}/nhop-negative-sampling
device                                              = cuda:0
epochs                                              = 15000
loss_fn__name                                       = bce
loss_fn__l2_norm                                    = False
tracker_config__log_root_dir                        = runs
tracker_config__early_stopping_rounds               = 40
tracker_config__epochs_per_checkpoint               = 0
tracker_config__save_n_best                         = 0
tracker_config__save_end                            = False
tracker_config__comment                             = .namazon.RGCN
tracker_config__verbose                             = False
tracker_config__progress                            = none
batch_config__train__name                           = whole_graph
batch_config__eval__name                            = whole_graph
evaluator_config__name                              = hgb-lp
evaluator_config__early_stopping_objective          = roc_auc
evaluator_config__epochs_per_eval                   = 50