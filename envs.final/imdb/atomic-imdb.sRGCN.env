dataset_config__name                                  = atomic-imdb
dataset_config__feat_types                            = {"keyword": "none", "director": "nid", "actor": "none", "color": "none", "language": "nid", "country": "nid", "content_rating": "nid", "numerical": "nid", "word": "nid", "movie": "none"}
dataset_config__raw_path                              = HGB
dataset_config__prepropagation_config__reduce_fn      = absmax
dataset_config__prepropagation_config__cache_dir      = ${WORK}/preprop-nimdb.HGB
dataset_config__exclude_edge_types                    = ["is-type-of", "has-color", "is-country-of", "is-from-country", "is-language-of", "is-in-language"]
hgnn_config__name                                     = RGCN
hgnn_config__hidden_dim                               = 128
hgnn_config__num_layers                               = 10
hgnn_config__num_out_layers                           = 2
hgnn_config__num_heads                                = 4
hgnn_config__activation                               = identity
hgnn_config__lr                                       = 0.0001
hgnn_config__weight_decay                             = 0.0001
hgnn_config__max_lr_scale                             = 1.5
hgnn_config__pct_start_epoch                          = 50
hgnn_config__dropout__feat                            = 0.55
hgnn_config__dropout__edge                            = 0.3
hgnn_config__use_norm                                 = False
hgnn_config__use_residual                             = True
hgnn_config__add_self_loop                            = True
hgnn_config__proj_by                                  = ntype
hgnn_config__linear_by                                = identity
hgnn_config__softmax_tau                              = 1.0
hgnn_config__aggregation                              = macro

device                                                = cuda:0
epochs                                                = 500
loss_fn__name                                         = soft_label_ce
loss_fn__l2_norm                                      = True
tracker_config__log_root_dir                          = runs
tracker_config__early_stopping_rounds                 = 50
tracker_config__epochs_per_checkpoint                 = 0
tracker_config__save_n_best                           = 0
tracker_config__save_end                              = False
tracker_config__comment                               = .nimdb.RGCN
tracker_config__verbose                               = True
tracker_config__progress                              = tqdm
batch_config__train__name                             = whole_graph
batch_config__eval__name                              = whole_graph
batch_config__device_mode                             = gpu
evaluator_config__name                                = hgb-mnc
evaluator_config__early_stopping_objective            = macro_f1
evaluator_config__epochs_per_eval                     = 1
evaluator_config__multi_label_thresholds_objective    = macro_f1
